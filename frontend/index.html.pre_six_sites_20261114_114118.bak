
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Jezero Pathfinder | Human Exploration System</title>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  >

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <header class="topbar">
    <div class="brand">
      <div class="brand-symbol">M</div>

      <div>
        <h1>Jezero PATHFINDER</h1>
        <p>Human Exploration Decision Support</p>
      </div>
    </div>

    <div class="topbar-right">
      <span class="prototype-label">SIMULATION</span>
      <span class="mission-label">JEZERO CRATER</span>
    </div>
  </header>

  <main class="app-layout">

    <aside class="sidebar">

      <div class="sidebar-header">
        <h2>Mission Workspace</h2>
        <p>Basecamp Expedition</p>
      </div>

      <nav class="workspace-tabs" aria-label="Mission tools">
        <button class="workspace-tab active"
                data-tab="explore"
                type="button">
          Explore
        </button>

        <button class="workspace-tab"
                data-tab="science"
                type="button">
          Science
        </button>

        <button class="workspace-tab"
                data-tab="terrain"
                type="button">
          Terrain
        </button>

        <button class="workspace-tab"
                data-tab="navigation"
                type="button">
          Navigation
        </button>

        <button class="workspace-tab"
                data-tab="mission"
                type="button">
          Mission
        </button>
              <button class="workspace-tab" data-tab="environment" type="button">Weather</button>
      </nav>

      <!-- EXPLORE -->
      <section class="tab-content active" id="tab-explore">
        <h3>Explore Jezero</h3>

        <p class="section-description">
          Select a scientific marker on the map to
          inspect the site and assign a destination.
        </p>

        <div class="info-card">
          <div class="card-heading">
            <span class="dot blue"></span>
            <strong>Basecamp</strong>
          </div>

          <p>Hypothetical human exploration base camp</p>

          <p class="muted">
            18.42871° N, 77.41327° E
          </p>

          <div class="metric-row">
            <span>Terrain assessment</span>
            <strong id="basecamp-assessment">
              Loading...
            </strong>
          </div>

          <p id="basecamp-details" class="small-text"></p>
        </div>

        <h3>Scientific Objective</h3>

        <label for="objective">Investigation focus</label>

        <select id="objective">
          <option value="sedimentary">
            Investigate sedimentary deposits
          </option>

          <option value="geology">
            Explore geological boundaries
          </option>

          <option value="minerals">
            Investigate mineral evidence
          </option>
        </select>

        <div class="info-card">
          <strong>Map Interaction</strong>

          <p>
            Orange markers indicate documented sites with previously
            tested coordinates. Other sites are information-only.
          </p>

          <p>
            Click a marker and choose
            <strong>Set Destination</strong>.
          </p>
        </div>
      </section>

      <!-- SCIENCE -->
      <section class="tab-content" id="tab-science">
        <h3>Scientific Investigation</h3>

        <div class="info-card science-selector" aria-label="Scientific site selector">
          <h4>Explore documented sites <span id="science-site-count" class="site-count">6 sites</span></h4>
          <div class="science-filter-row" role="group" aria-label="Filter by scientific discipline">
            <button type="button" class="science-filter active" data-science-filter="All" aria-pressed="true">All</button>
            <button type="button" class="science-filter" data-science-filter="Geology" aria-pressed="false">Geology</button>
            <button type="button" class="science-filter" data-science-filter="Sedimentary" aria-pressed="false">Sedimentary</button>
            <button type="button" class="science-filter" data-science-filter="Astrobiology" aria-pressed="false">Astrobiology</button>
          </div>
          <div id="science-site-list" class="science-site-list" aria-label="Available scientific sites"></div>
          <p class="small-text">Three previously tested sites are route-enabled. Other sites remain information-only until exact coordinates and raster coverage are verified.</p>
        </div>

        <div id="science-panel" class="info-card">
          <h4 id="science-title">No site selected</h4>

          <p id="science-description">
            Click an orange scientific marker to
            investigate a potential research location.
          </p>

          <button id="science-assign-destination" type="button" class="primary-button">Set as Mission Destination</button>

          <div class="science-detail">
            <strong>Scientific Objective</strong>
            <p id="science-objective">Not selected</p>
          </div>

          <div class="science-detail">
            <strong>Scientific Significance</strong>
            <p id="science-significance">
              Not available
            </p>
          </div>

          <div class="science-detail">
            <strong>Evidence and Confidence</strong>
            <p id="science-evidence">
              Not assessed
            </p>
          </div>

          <div class="science-detail">
            <strong>Safety Assessment</strong>
            <p id="science-safety">
              Awaiting site selection.
            </p>
          </div>
        </div>
      </section>

      <!-- TERRAIN -->
            <!-- ENVIRONMENT: NASA MEDA archived observations -->
      <section class="tab-content" id="tab-environment">
        <h3>Environmental Intelligence</h3>
        <p class="section-description">NASA Perseverance MEDA calibrated observations, Sol 1859. Historical measurements near the rover, not live weather and not readings at Basecamp.</p>
        <div class="info-card environment-info">
          <strong>Archived observation data</strong>
          <p>Air temperature (ATS) and atmospheric pressure (PS). Charts show averages of observed measurements in five-minute local solar time bins. Unsampled periods remain blank.</p>
          <p id="meda-observation-count" class="small-text">Loading archived measurements...</p>
        </div>
        <div class="info-card">
          <h4>Air temperature</h4>
          <label for="meda-temp-sensor">Temperature sensor</label>
          <select id="meda-temp-sensor">
            <option value="t1">ATS 1 · RSM 50°</option>
            <option value="t2">ATS 2 · RSM 155°</option>
            <option value="t3">ATS 3 · RSM 290°</option>
            <option value="t4">ATS 4 · RFB port</option>
            <option value="t5">ATS 5 · RFB starboard</option>
          </select>
          <div class="environment-metrics">
            <div><span>Observed mean</span><strong id="meda-temp-mean">-- °C</strong></div>
            <div><span>Recorded min / max</span><strong id="meda-temp-range">--</strong></div>
          </div>
          <div id="meda-temp-chart" class="environment-chart" aria-live="polite"></div>
          <p class="small-text">Martian Local Mean Solar Time (LMST). Sensor orientation can affect individual readings.</p>
        </div>
        <div class="info-card">
          <h4>Atmospheric pressure</h4>
          <label for="meda-pressure-sensor">Pressure sensor</label>
          <select id="meda-pressure-sensor">
            <option value="p3">BAROCAP 3 · transducer 1</option>
            <option value="p1">BAROCAP 1</option>
            <option value="p2">BAROCAP 2</option>
          </select>
          <div class="environment-metrics">
            <div><span>Observed mean</span><strong id="meda-pressure-mean">-- Pa</strong></div>
            <div><span>Recorded min / max</span><strong id="meda-pressure-range">--</strong></div>
          </div>
          <div id="meda-pressure-chart" class="environment-chart" aria-live="polite"></div>
          <p class="small-text">Pressure uncertainty fields were empty in the downloaded CSV. Values are not flight-safety limits.</p>
        </div>
        <div class="info-card">
          <h4>Scientific provenance and limitations</h4>
          <p>Source: <a href="https://atmos.nmsu.edu/PDS/data/PDS4/Mars2020/mars2020_meda/data_calibrated_env/sol_1740_1859/sol_1859/" target="_blank" rel="noopener noreferrer">NASA Planetary Data System, MEDA calibrated archive, Sol 1859</a>.</p>
          <p class="small-text">The data represent Perseverance's local environment during this archived sol. Measurements were acquired intermittently under the instrument's operating schedule. Chart gaps are not interpolated. This is not a crater-wide weather map, real-time weather service, or certified astronaut safety assessment.</p>
        </div>
      </section>

<section class="tab-content" id="tab-terrain">
        <h3>Terrain Analysis</h3>

        <p class="section-description">
          Inspect terrain classifications derived
          from the Jezero hazard raster.
        </p>

        <div class="info-card">
          <label class="checkbox-label">
            <input type="checkbox"
                   id="show-hazards">
            Show terrain hazard overlay
          </label>

          <label class="checkbox-label">
            <input type="checkbox"
                   id="show-sites"
                   checked>
            Show scientific sites
          </label>

          <label class="checkbox-label">
            <input type="checkbox"
                   id="show-hirise"
                   checked>
            Show HiRISE imagery (25 cm/pixel)
          </label>

          <label class="checkbox-label">
            <input type="checkbox"
                   id="show-ctx"
                   checked>
            Show CTX imagery
          </label>

          <label class="checkbox-label">
            <input type="checkbox"
                   id="show-coverage"
                   checked>
            Show CTX coverage boundary
          </label>
        </div>

        <div class="info-card">
          <h4>Hazard Classification</h4>

          <div class="legend-row">
            <span class="legend-dot hazard-low"></span>
            Class 1: Lower concern
          </div>

          <div class="legend-row">
            <span class="legend-dot hazard-medium"></span>
            Class 2: Elevated concern
          </div>

          <div class="legend-row">
            <span class="legend-dot hazard-high"></span>
            Class 3: Restricted
          </div>

          <p class="small-text">
            Prototype classification. Not certified
            for human or rover operations.
          </p>
        </div>
      </section>

      <!-- NAVIGATION -->
      <section class="tab-content" id="tab-navigation">
        <h3>Mission Navigation</h3>
        <!-- JEZERO_WAYPOINT_PLANNER_V1: choose any two traversable map points -->
        <div class="info-card waypoint-planner" id="point-to-point-planner">
          <h4>Point-to-point route planner</h4>
          <p class="small-text">Choose Start and Destination on the map or use a documented science site. Compares A* routes and calculates one-way travel time and terrain-adjusted energy.</p>
          <div class="waypoint-pick-grid">
            <button type="button" id="wp-pick-start" class="wp-action">Pick Start on map</button>
            <button type="button" id="wp-pick-end" class="wp-action">Pick Destination on map</button>
          </div>
          <div class="waypoint-pick-grid">
            <div><label for="wp-start-select">Start</label><select id="wp-start-select"></select></div>
            <div><label for="wp-end-select">Destination</label><select id="wp-end-select"></select></div>
          </div>
          <p class="small-text" id="wp-start-readout">Start: Basecamp</p>
          <p class="small-text" id="wp-end-readout">Destination: Rochette</p>
          <div class="waypoint-pick-grid">
            <div><label for="wp-speed">Speed (km/h)</label><input type="number" id="wp-speed" min="0.1" max="20" step="0.5" value="4"></div>
            <div><label for="wp-energy-rate">Baseline energy (kWh/km)</label><input type="number" id="wp-energy-rate" min="0.1" max="50" step="0.1" value="1.5"></div>
            <div><label for="wp-energy-budget">Battery budget (kWh)</label><input type="number" id="wp-energy-budget" min="1" max="1000" step="1" value="20"></div>
            <div><label for="wp-time-budget">Time budget (hours)</label><input type="number" id="wp-time-budget" min="1" max="72" step="0.5" value="8"></div>
          </div>
          <p class="small-text">One-way simulation; 25% energy and 20% time held in reserve. Uses the same terrain model as the existing mission analysis.</p>
          <button type="button" id="wp-calculate" class="primary-button">Compare two-point A* routes</button>
          <div id="wp-results" class="results-panel" aria-live="polite"></div>
        </div>
        <h4 class="wp-original-heading">Basecamp expedition (original planner)</h4>


        <div class="info-card">
          <div class="metric-row">
            <span>Starting point</span>
            <strong>Basecamp</strong>
          </div>

          <div class="metric-row">
            <span>Destination</span>
            <strong id="routing-destination">
              Not assigned
            </strong>
          </div>

          <button id="calculate-routes"
                  class="primary-button"
                  type="button">
            Compare A* Routes
          </button>

          <div id="routing-results"
               class="results-panel"
               aria-live="polite">
          </div>
        </div>

        <div class="info-card">
          <h4>Route Legend</h4>

          <div class="legend-row">
            <span class="route-swatch safest"></span>
            Safest route
          </div>

          <div class="legend-row">
            <span class="route-swatch shortest"></span>
            Shortest route
          </div>
        </div>
      </section>

      <!-- MISSION -->
      <section class="tab-content" id="tab-mission">
        <h3>Mission Status</h3>

        <div class="info-card">
          <div class="metric-row">
            <span>Base camp</span>
            <strong>Alpha</strong>
          </div>

          <div class="metric-row">
            <span>Human survivability</span>
            <strong>Not assessed</strong>
          </div>

          <div class="metric-row">
            <span>Landing certification</span>
            <strong>No</strong>
          </div>
        </div>

        <h3>Terrain-Aware Mission Analysis</h3>

        <p class="section-description">
          Evaluate a hypothetical rover excursion, terrain-adjusted
          energy demand, and return to Basecamp.
        </p>

        <div class="info-card">

          <label for="mission-route-mode">
            Routing objective
          </label>

          <select id="mission-route-mode">
            <option value="safest">
              Safest traversable route
            </option>

            <option value="shortest">
              Shortest traversable route
            </option>
          </select>

          <label for="rover-speed">
            Rover speed (km/h)
          </label>

          <input id="rover-speed"
                 type="number"
                 min="0.1"
                 max="20"
                 step="0.5"
                 value="4">

          <label for="rover-energy">
            Travel energy (kWh/km)
          </label>

          <input id="rover-energy"
                 type="number"
                 min="0.1"
                 max="50"
                 step="0.1"
                 value="1.5">

          <label for="mission-energy">
            Available energy (kWh)
          </label>

          <input id="mission-energy"
                 type="number"
                 min="1"
                 max="1000"
                 step="1"
                 value="20">

          <label for="mission-hours">
            Maximum mission duration (hours)
          </label>

          <input id="mission-hours"
                 type="number"
                 min="1"
                 max="72"
                 step="1"
                 value="8">

          <label for="science-hours">
            Science activity duration (hours)
          </label>

          <input id="science-hours"
                 type="number"
                 min="0"
                 max="24"
                 step="0.5"
                 value="1">

          <p class="small-text">
            Hypothetical planning parameters.
            Reserve assumptions: 25% energy
            and 20% time.
          </p>

          <button id="roundtrip-button"
                  class="primary-button"
                  type="button">
            Analyse Round Trip
          </button>

          <div id="roundtrip-results"
               class="results-panel"
               aria-live="polite">
          </div>
        </div>
      </section>

      <div class="sidebar-footer">
        <span class="status-dot"></span>
        <p id="status">
          Initialising Mars Pathfinder...
        </p>
      </div>

    </aside>

    <section class="map-workspace">

      <div id="map"></div>

      <div class="map-overlay-label">
        JEZERO CRATER
        <span>MARS SURFACE EXPLORATION</span>
      </div>

      <div class="map-legend">
        <div>
          <span class="legend-dot basecamp-dot"></span>
          Basecamp
        </div>

        <div>
          <span class="legend-dot science-dot"></span>
          Scientific site
        </div>

        <div>
          <span class="route-swatch safest"></span>
          Safest route
        </div>

        <div>
          <span class="route-swatch shortest"></span>
          Shortest route
        </div>
      </div>

      <div class="map-warning">
        PROTOTYPE TERRAIN MODEL
        <span>Not certified for human operations</span>
      </div>

    </section>

  </main>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="script.js"></script>
  <script src="environment.js"></script>

  <script src="route_planner.js"></script>
</body>
</html>
